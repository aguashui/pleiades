{
    "name": "bitfighter/pleiades",
    "description": "The Bitfighter Level Database (Pleiades)",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://bitfighter.org/levels",
    "require": {
        "php": ">=8.1.0",
        "composer/installers": "^1.0 || ^2.0",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*"
    },
    "extra": {
        "installer-paths": {
            "app/Plugin/{$name}": ["type:cakephp-plugin"]
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
